#include <stdio.h>  // 包含标准输入输出库，用于printf等函数
#include <stdlib.h> // 包含标准库函数

// 直接插入排序函数
void insertionSort(int arr[], int n) { // 定义插入排序函数，接收数组和数组大小
    int i, key, j; // 声明三个整型变量：i用于外层循环，key存储当前要插入的元素，j用于内层循环

    for (i = 1; i < n; i++) { // 从数组第二个元素开始遍历（索引为1），到数组末尾
        key = arr[i]; // 将当前元素（待插入的元素）保存到key变量中
        j = i - 1;    // 将j初始化为当前元素的前一个位置，用于向左比较

        // 将大于key的元素向右移动一位
        while (j >= 0 && arr[j] > key) { // 当j在数组范围内且当前比较的元素大于key时循环
            arr[j + 1] = arr[j]; // 将较大的元素向右移动一位
            j = j - 1; // j索引向左移动一位，准备比较下一个元素
        }
        
        // 将key插入到正确的位置
        arr[j + 1] = key; // 将key插入到找到的正确位置（j+1处）
    }
}
