#include <stdio.h>  // 包含标准输入输出库，用于printf等函数
#include <stdlib.h> // 包含标准库函数，如malloc和free

// 调整堆结构，使其满足最大堆的性质
void heapify(int arr[], int n, int i) { // 定义heapify函数，接收数组、数组大小和当前节点索引
    int largest = i;    // 假设当前节点是最大值，初始化最大值索引为i
    int left = 2 * i + 1;   // 计算左子节点的索引（基于0的索引）
    int right = 2 * i + 2;  // 计算右子节点的索引（基于0的索引）

    // 如果左子节点存在且大于当前最大值，则更新最大值索引
    if (left < n && arr[left] > arr[largest]) // 检查左子节点是否在数组范围内且大于当前最大值
        largest = left; // 更新最大值索引为左子节点索引

    // 如果右子节点存在且大于当前最大值，则更新最大值索引
    if (right < n && arr[right] > arr[largest]) // 检查右子节点是否在数组范围内且大于当前最大值
        largest = right; // 更新最大值索引为右子节点索引

    // 如果最大值不是当前节点，则交换并继续调整堆
    if (largest != i) { // 如果最大值索引不是当前节点索引
        int temp = arr[i];      // 将当前节点的值保存到临时变量
        arr[i] = arr[largest];  // 将最大值节点的值赋给当前节点
        arr[largest] = temp;    // 将临时变量的值赋给最大值节点（完成交换）

        // 递归调整受影响的子树
        heapify(arr, n, largest); // 递归调用heapify函数调整以新的最大值节点为根的子树
    }
}

// 堆排序主函数
void heapSort(int arr[], int n) { // 定义堆排序函数，接收数组和数组大小
    // 构建最大堆：从最后一个非叶子节点开始向上调整
    for (int i = n / 2 - 1; i >= 0; i--) { // 从最后一个非叶子节点（n/2-1）开始向前遍历
        heapify(arr, n, i); // 调用heapify函数调整以节点i为根的子树
    }

    // 逐个提取堆顶元素并重新调整堆
    for (int i = n - 1; i > 0; i--) { // 从数组最后一个位置开始向前遍历
        // 将堆顶（最大值）与当前未排序部分的最后一个元素交换
        int temp = arr[0];    // 将堆顶元素（最大值）保存到临时变量
        arr[0] = arr[i];      // 将未排序部分的最后一个元素赋给堆顶
        arr[i] = temp;        // 将临时变量（原堆顶最大值）赋给未排序部分的最后位置

        // 重新调整剩余元素构成的堆
        heapify(arr, i, 0); // 调用heapify函数调整以堆顶为根、大小为i的堆
    }
}
