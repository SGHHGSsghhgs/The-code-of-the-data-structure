#include <stdio.h>  // 包含标准输入输出库，用于printf等函数
#include <stdlib.h> // 包含标准库函数，如malloc和free

// 合并两个已排序的子数组
void merge(int arr[], int left, int mid, int right) { // 定义merge函数，接收数组和三个索引参数
    int i, j, k; // 声明三个整型变量用于循环和索引
    int n1 = mid - left + 1;  // 计算左子数组的长度
    int n2 = right - mid;     // 计算右子数组的长度

    // 创建临时数组
    int *L = (int*)malloc(n1 * sizeof(int)); // 动态分配内存给左临时数组
    int *R = (int*)malloc(n2 * sizeof(int)); // 动态分配内存给右临时数组

    // 复制数据到临时数组
    for (i = 0; i < n1; i++) // 循环遍历左子数组的所有元素
        L[i] = arr[left + i]; // 将原数组左半部分复制到左临时数组
    for (j = 0; j < n2; j++) // 循环遍历右子数组的所有元素
        R[j] = arr[mid + 1 + j]; // 将原数组右半部分复制到右临时数组

    // 合并临时数组回原数组
    i = 0;    // 初始化左临时数组的索引为0
    j = 0;    // 初始化右临时数组的索引为0
    k = left; // 初始化合并后数组的索引为left

    while (i < n1 && j < n2) { // 当左右临时数组都还有元素未处理时循环
        if (L[i] <= R[j]) { // 比较左右临时数组当前元素
            arr[k] = L[i]; // 将较小的元素复制到原数组
            i++; // 左临时数组索引向后移动一位
        } else {
            arr[k] = R[j]; // 将较小的元素复制到原数组
            j++; // 右临时数组索引向后移动一位
        }
        k++; // 原数组索引向后移动一位
    }

    // 复制左临时数组的剩余元素（如果存在）
    while (i < n1) { // 当左临时数组还有剩余元素时
        arr[k] = L[i]; // 将剩余元素复制到原数组
        i++; // 左临时数组索引向后移动一位
        k++; // 原数组索引向后移动一位
    }
    // 复制右临时数组的剩余元素（如果存在）
    while (j < n2) { // 当右临时数组还有剩余元素时
        arr[k] = R[j]; // 将剩余元素复制到原数组
        j++; // 右临时数组索引向后移动一位
        k++; // 原数组索引向后移动一位
    }

    // 释放临时数组内存
    free(L); // 释放左临时数组占用的内存
    free(R); // 释放右临时数组占用的内存
}

// 归并排序主函数
void mergeSort(int arr[], int left, int right) { // 定义归并排序函数，接收数组和左右边界索引
    if (left < right) { // 如果左边界小于右边界（数组长度大于1）
        int mid = left + (right - left) / 2; // 计算中点索引，防止整数溢出

        // 递归排序左右两半
        mergeSort(arr, left, mid); // 递归调用归并排序处理左半部分
        mergeSort(arr, mid + 1, right); // 递归调用归并排序处理右半部分

        // 合并已排序的两半
        merge(arr, left, mid, right); // 调用merge函数合并两个已排序的部分
    }
}
