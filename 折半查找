#include <stdio.h>  // 包含标准输入输出库，用于printf等函数
#include <stdlib.h> // 包含标准库函数

// 折半查找（二分查找）函数
int binarySearch(int arr[], int n, int target) { // 定义二分查找函数，接收已排序数组、数组大小和目标值
    int left = 0;        // 初始化左边界索引为0
    int right = n - 1;   // 初始化右边界索引为数组最后一个元素的索引
    int mid;             // 声明中间位置索引变量

    while (left <= right) { // 当左边界小于等于右边界时循环（搜索区间有效）
        mid = left + (right - left) / 2; // 计算中间位置索引，防止整数溢出

        if (arr[mid] == target) { // 如果中间元素等于目标值
            return mid; // 找到目标值，返回中间位置的索引
        }
        
        if (arr[mid] < target) { // 如果中间元素小于目标值
            left = mid + 1; // 目标值在右半部分，更新左边界为mid+1
        } else { // 如果中间元素大于目标值
            right = mid - 1; // 目标值在左半部分，更新右边界为mid-1
        }
    }
    
    return -1; // 如果循环结束仍未找到目标值，返回-1表示未找到
}
