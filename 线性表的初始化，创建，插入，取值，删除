#include <stdio.h>  // 包含标准输入输出库
#include <stdlib.h> // 包含标准库函数
#include <string.h> // 包含字符串处理函数

#define MAX_SIZE 100 // 定义线性表的最大容量

// 定义线性表结构体
struct LinearList { // 定义LinearList结构体
    int data[MAX_SIZE]; // 定义整型数组存储数据元素
    int length;         // 定义整型变量记录当前表的长度
};

// 初始化线性表
void initList(struct LinearList* list) { // 定义初始化线性表的函数
    list->length = 0; // 将表长度初始化为0
    printf("线性表初始化完成\n"); // 输出初始化完成信息
}

// 创建线性表（添加元素）
void createList(struct LinearList* list, int value) { // 定义创建（添加元素）函数
    if (list->length >= MAX_SIZE) { // 检查线性表是否已满
        printf("线性表已满，无法添加元素\n"); // 如果已满，输出错误信息
        return; // 返回，不执行添加操作
    }
    list->data[list->length] = value; // 将值添加到表的末尾
    list->length++; // 表长度加1
    printf("添加元素 %d 成功\n", value); // 输出添加成功信息
}

// 在指定位置插入元素
void insertElement(struct LinearList* list, int position, int value) { // 定义插入元素函数
    if (position < 0 || position > list->length) { // 检查插入位置是否合法
        printf("插入位置不合法\n"); // 如果位置不合法，输出错误信息
        return; // 返回，不执行插入操作
    }
    if (list->length >= MAX_SIZE) { // 检查线性表是否已满
        printf("线性表已满，无法插入元素\n"); // 如果已满，输出错误信息
        return; // 返回，不执行插入操作
    }
    
    // 将插入位置及之后的元素向后移动一位
    for (int i = list->length; i > position; i--) { // 从表尾开始向前移动元素
        list->data[i] = list->data[i - 1]; // 将前一个元素的值复制到当前位置
    }
    
    list->data[position] = value; // 在指定位置插入新值
    list->length++; // 表长度加1
    printf("在位置 %d 插入元素 %d 成功\n", position, value); // 输出插入成功信息
}

// 取值操作（获取指定位置的元素）
int getElement(struct LinearList* list, int position) { // 定义取值函数
    if (position < 0 || position >= list->length) { // 检查位置是否合法
        printf("位置不合法，无法取值\n"); // 如果位置不合法，输出错误信息
        return -1; // 返回-1表示错误
    }
    return list->data[position]; // 返回指定位置的元素值
}

// 删除指定位置的元素
int deleteElement(struct LinearList* list, int position) { // 定义删除元素函数
    if (position < 0 || position >= list->length) { // 检查删除位置是否合法
        printf("删除位置不合法\n"); // 如果位置不合法，输出错误信息
        return -1; // 返回-1表示错误
    }
    
    int deletedValue = list->data[position]; // 保存要删除的元素值
    // 将删除位置之后的元素向前移动一位
    for (int i = position; i < list->length - 1; i++) { // 从删除位置开始向后移动元素
        list->data[i] = list->data[i + 1]; // 将后一个元素的值复制到当前位置
    }
    
    list->length--; // 表长度减1
    printf("删除位置 %d 的元素 %d 成功\n", position, deletedValue); // 输出删除成功信息
    return deletedValue; // 返回被删除的元素值
}

// 打印线性表
void printList(struct LinearList* list) { // 定义打印线性表的函数
    if (list->length == 0) { // 检查线性表是否为空
        printf("线性表为空\n"); // 如果为空，输出提示信息
        return; // 返回
    }
    
    printf("线性表内容: "); // 输出提示信息
    for (int i = 0; i < list->length; i++) { // 遍历线性表的所有元素
        printf("%d ", list->data[i]); // 输出当前元素
    }
    printf("\n"); // 输出换行符
}

int main() { // 主函数入口
    struct LinearList list; // 声明线性表变量
    
    // 初始化线性表
    initList(&list); // 调用初始化函数
    
    // 创建线性表（添加元素）
    printf("\n创建线性表:\n"); // 输出提示信息
    createList(&list, 1); // 添加元素1
    createList(&list, 2); // 添加元素2
    createList(&list, 3); // 添加元素3
    printList(&list); // 打印线性表
    
    // 插入元素
    printf("\n插入元素:\n"); // 输出提示信息
    insertElement(&list, 1, 99); // 在位置1插入元素99
    printList(&list); // 打印线性表
    
    // 取值操作
    printf("\n取值操作:\n"); // 输出提示信息
    int value = getElement(&list, 2); // 获取位置2的元素
    if (value != -1) { // 检查取值是否成功
        printf("位置2的元素值为: %d\n", value); // 输出取到的元素值
    }
    
    // 删除元素
    printf("\n删除元素:\n"); // 输出提示信息
    int deleted = deleteElement(&list, 1); // 删除位置1的元素
    if (deleted != -1) { // 检查删除是否成功
        printList(&list); // 打印删除后的线性表
    }
    
    return 0; // 返回0表示程序正常结束
}
